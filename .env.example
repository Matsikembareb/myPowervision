# =============================================================================
# SHARED CONFIGURATION - Used by all prototypes
# =============================================================================

# Flask Secret Key (REQUIRED for all prototypes)
SECRET_KEY=your-secret-key-here-generate-with-python-secrets

# Database Configuration
DATABASE_URL=sqlite:///app.db

# =============================================================================
# EMAIL CONFIGURATION (for prototype_microblog and 01prototype)
# =============================================================================

MAIL_SERVER=smtp.googlemail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# Admin email addresses (comma-separated)
ADMINS=your-email@gmail.com

# =============================================================================
# MICROSOFT TRANSLATOR API (for prototype_microblog translation features)
# =============================================================================

MS_TRANSLATOR_KEY=your-microsoft-translator-api-key

# =============================================================================
# PAGINATION & APP SETTINGS
# =============================================================================

POSTS_PER_PAGE=25
LANGUAGES=en,es

# =============================================================================
# PROTOTYPE-SPECIFIC SETTINGS
# =============================================================================

# 01prototype (myPowervision) - UMS/Job Management System
# Add any specific configs here

# prototype_market - Flask Market
# Add any specific configs here

# prototype_microblog - Microblog
